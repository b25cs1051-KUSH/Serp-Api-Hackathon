# PharmaWatch API for a 512 MB host (Render free plan). Build from the repo root:
#   docker build -f api/Dockerfile.render -t pharmawatch-api-render .
# Differences from api/Dockerfile: no PyTorch / sentence-transformers; the same embedding model runs
# on onnxruntime (EMBEDDING_BACKEND=onnx). Keys are never baked in: the host passes them at runtime.
FROM python:3.13-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONIOENCODING=utf-8 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HF_HOME=/opt/hf \
    HF_HUB_DISABLE_TELEMETRY=1 \
    EMBEDDING_BACKEND=onnx \
    OMP_NUM_THREADS=1

WORKDIR /app

COPY api/requirements-render.txt ./
RUN pip install -r requirements-render.txt

RUN useradd --create-home --uid 10001 app && mkdir -p /opt/hf && chown app /opt/hf
USER app

# Model files at build time (tokenizer + fp32 ONNX graph, ~90 MB), so start-up needs no download.
RUN python -c "from huggingface_hub import hf_hub_download as d; r='sentence-transformers/all-MiniLM-L6-v2'; d(r,'tokenizer.json'); d(r,'onnx/model.onnx')"

COPY serpapi_cache ./serpapi_cache
COPY pharmawatch ./pharmawatch
COPY notes/postal_codes_delivery_rules.json ./notes/
COPY api ./api

# Render sets PORT; 8000 locally.
EXPOSE 8000
CMD ["sh", "-c", "exec python -m uvicorn api.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
