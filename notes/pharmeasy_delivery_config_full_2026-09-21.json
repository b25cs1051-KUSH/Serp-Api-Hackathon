{
  "project": "PharmEasy - SerpAPI Hackathon",
  "version": "2.0",
  "research_date": "2026-09-21",
  "currency": "INR",
  "description": "Delivery/serviceability estimation knowledge base for online medicine price comparison. Values marked null are not reliably published as a universal current rule and should be resolved from pincode/cart/checkout when possible.",
  "pincode_data": {
    "input_format": "6-digit Indian PIN code",
    "exact_lookup_required": true,
    "official_source": "https://data.gov.in/catalog/all-india-pincode-directory-through-webservice",
    "official_resource": "https://data.gov.in/resource/all-india-pincode-directory-till-last-month",
    "reference_mirror": "https://github.com/iaseth/pincodes-india/blob/master/pincodes.json",
    "reference_valid_pincode_count": 18991,
    "reference_dataset_note": "The current public mirror used for reference lists 18,991 valid PINs. The Government OGD catalogue is the preferred refresh source; do not treat a static PIN list as permanent.",
    "resolution_order": [
      "validate 6 digits",
      "resolve exact PIN to post office/locality/district/state",
      "classify locality into metro/tier_1/tier_2/tier_3/remote using maintained city-tier data",
      "check platform-specific serviceability",
      "apply platform delivery rule",
      "use checkout value as final source of truth"
    ]
  },
  "pin_zones": {
    "metro": {
      "pin3_prefixes": [
        "110",
        "400",
        "500",
        "560",
        "600",
        "700",
        "380",
        "411"
      ],
      "cities": [
        "Delhi / New Delhi",
        "Mumbai",
        "Hyderabad",
        "Bengaluru",
        "Chennai",
        "Kolkata",
        "Ahmedabad",
        "Pune"
      ],
      "classification": "major-metro seed list",
      "warning": "PIN prefixes are only a heuristic. Resolve the full PIN and locality before using this as a production tier."
    },
    "tier_1": {
      "pin3_prefixes": [
        "122",
        "201",
        "226",
        "208",
        "302",
        "395",
        "390",
