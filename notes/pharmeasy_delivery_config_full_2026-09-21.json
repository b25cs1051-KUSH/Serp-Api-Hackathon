      ],
      "cities_or_urban_areas": [
        "Gurugram",
        "Noida / Ghaziabad",
        "Lucknow",
        "Kanpur",
        "Jaipur",
        "Surat",
        "Vadodara",
        "Nashik",
        "Nagpur",
        "Indore",
        "Bhopal",
        "Vijayawada",
        "Visakhapatnam",
        "Mysuru",
        "Coimbatore",
        "Kochi",
        "Bhubaneswar",
        "Guwahati",
        "Patna"
      ],
      "classification": "heuristic large-urban seed list"
    },
    "tier_2": {
      "pin3_prefixes": [],
      "classification": "Use maintained city-tier table after resolving exact PIN/locality; intentionally not hard-coded by first 1-2 PIN digits."
    },
    "tier_3": {
      "pin3_prefixes": [],
      "classification": "Fallback for valid serviceable PINs not matched to a maintained metro/tier-1/tier-2/remote locality."
    },
    "remote": {
      "pin3_prefixes": [
        "190",
        "191",
        "192",
        "193",
        "194",
        "744",
        "682",
        "791",
        "792",
        "793",
        "794",
        "795",
        "796",
        "797",
        "798",
        "799"
      ],
      "areas": [
        "Jammu & Kashmir high-friction postal areas (seed only)",
        "Andaman & Nicobar Islands",
        "Lakshadweep",
        "Arunachal Pradesh / Meghalaya / Manipur / Mizoram / Nagaland / Tripura remote areas (seed only)"
      ],
      "classification": "remote-risk seed list, NOT a universal unserviceability list",
      "warning": "Many urban locations share these prefixes. Exact serviceability must be checked per platform."
    },
    "unserviceable": {
      "pin3_prefixes": [],
      "classification": "Platform-specific; do not hard-code generic unserviceable PINs. A PIN can be serviceable on one platform and unavailable on another."
    },
    "default": "tier_3"
  },
  "estimator": {
    "formula": "estimated_total = advertised_item_total + delivery_fee + platform_fee + handling_fee + cod_fee - known_discount",
    "unknown_value_policy": "Use null for unknown/dynamic charges and expose confidence rather than guessing.",
    "checkout_disclaimer": "Final checkout price can differ from the SERP/Shopping advertised price.",
    "state_to_track": [
      "pincode",
      "cart_subtotal_before_coupon",
      "cart_subtotal_after_coupon",
      "quantity",
      "package_weight_if_needed",
      "customer_status",
      "membership",
      "payment_method",
      "medicine_only_vs_general_merchandise",
      "observed_timestamp"
    ]
  },
