# Copy to .env (git-ignored) and fill in. Only SERP_API_KEY is required.

# SerpApi (https://serpapi.com/manage-api-key)
SERP_API_KEY=
# Optional second key: used only when SERPAPI_ROTATE_KEYS=1 and the first runs out
SERP_API_KEY_2=
SERPAPI_ROTATE_KEYS=0

# Gemini, optional: only reads ambiguous misspellings (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash,gemini-2.5-flash-lite

# Redis (docker compose up -d redis)
REDIS_HOST=localhost
REDIS_PORT=6379

# API guards
# MAX_CONCURRENT_SEARCHES=4
# SEARCH_TIMEOUT_S=90
# SERPAPI_TIMEOUT=30
# DAILY_CREDIT_BUDGET=0          # 0 = no limit
# UI_ORIGINS=http://localhost:3000
